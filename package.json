{
  "name": "pi-verified-goal",
  "version": "0.1.0",
  "description": "Codex-style /goal for pi where completion must pass a verify command and an independent read-only auditor the agent cannot edit or switch off.",
  "keywords": ["pi-package", "pi", "pi-extension", "goal", "autonomous", "auditor"],
  "license": "MIT",
  "author": "Jarno Keskikangas",
  "type": "module",
  "engines": { "node": ">=22" },
  "files": ["src", "README.md", "LICENSE"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@types/node": "^26.6.4",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  }
}
